name: kodo
services:
  api:
    build:
      context: /Users/ray/developer/github/kodo/services/api
      dockerfile: Dockerfile
    cap_drop:
      - ALL
    environment:
      KODO_BIND: 0.0.0.0:8080
      KODO_DATABASE_URL: sqlite:///data/kodo.sqlite
      KODO_OPERATION_BURST: "60"
      KODO_OPERATIONS_PER_MINUTE: "120"
      KODO_REGISTRATIONS_PER_HOUR: "10"
      KODO_SNAPSHOTS_PER_MINUTE: "6"
    networks:
      default: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 8080
        published: "8080"
        protocol: tcp
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    volumes:
      - type: volume
        source: kodo-data
        target: /data
        volume: {}
networks:
  default:
    name: kodo_default
volumes:
  kodo-data:
    name: kodo_kodo-data
