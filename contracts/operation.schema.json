{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kodo Operation",
  "$ref": "#/components/schemas/Operation",
  "components": {
    "schemas": {
      "ProjectPayload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Trim before enqueue; Unicode scalar count; reject controls and all-whitespace."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "description": "Immutable after any entry, including voided entries, exists."
          },
          "icon_key": {
            "type": "string",
            "enum": [
              "dumbbell",
              "book",
              "leaf",
              "code",
              "droplet",
              "check"
            ]
          },
          "quick_amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "archived": {
            "type": "boolean"
          },
          "created_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          },
          "updated_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          }
        },
        "required": [
          "name",
          "unit",
          "icon_key",
          "quick_amount",
          "archived",
          "created_at_utc_ms",
          "updated_at_utc_ms"
        ]
      },
      "EntryPayload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999,
            "description": "Positive integer literal on the wire. Reject 1.0, 1e0, booleans and numeric strings in the typed decoder; JSON Schema alone cannot distinguish all lexical encodings."
          },
          "occurred_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          },
          "utc_offset_minutes": {
            "type": "integer",
            "minimum": -840,
            "maximum": 840
          },
          "local_date": {
            "type": "string",
            "format": "date",
            "description": "Date at occurrence, equal to UTC timestamp + captured offset. Never regroup old entries in a new timezone."
          }
        },
        "required": [
          "project_id",
          "amount",
          "occurred_at_utc_ms",
          "utc_offset_minutes",
          "local_date"
        ]
      },
      "VoidPayload": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "voided_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          }
        },
        "required": [
          "voided_at_utc_ms"
        ]
      },
      "ProjectPutOperation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "const": "project.put"
          },
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "payload": {
            "$ref": "#/components/schemas/ProjectPayload"
          }
        },
        "required": [
          "op_id",
          "seq",
          "kind",
          "entity_id",
          "payload"
        ]
      },
      "EntryAddOperation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "const": "entry.add"
          },
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "payload": {
            "$ref": "#/components/schemas/EntryPayload"
          }
        },
        "required": [
          "op_id",
          "seq",
          "kind",
          "entity_id",
          "payload"
        ]
      },
      "EntryVoidOperation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "const": "entry.void"
          },
          "entity_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "payload": {
            "$ref": "#/components/schemas/VoidPayload"
          }
        },
        "required": [
          "op_id",
          "seq",
          "kind",
          "entity_id",
          "payload"
        ]
      },
      "Operation": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ProjectPutOperation"
          },
          {
            "$ref": "#/components/schemas/EntryAddOperation"
          },
          {
            "$ref": "#/components/schemas/EntryVoidOperation"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "project.put": "#/components/schemas/ProjectPutOperation",
            "entry.add": "#/components/schemas/EntryAddOperation",
            "entry.void": "#/components/schemas/EntryVoidOperation"
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "secret": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "32 cryptographically random bytes, base64url without padding. Client MUST persist before request. Decode must yield exactly 32 bytes."
          }
        },
        "required": [
          "installation_id",
          "secret"
        ]
      },
      "RegistrationResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "existing"
            ]
          }
        },
        "required": [
          "installation_id",
          "status"
        ]
      },
      "OperationAck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "op_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "duplicate"
            ]
          },
          "accepted_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          }
        },
        "required": [
          "op_id",
          "seq",
          "status",
          "accepted_at_utc_ms"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "expected_seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Trim before enqueue; Unicode scalar count; reject controls and all-whitespace."
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8,
            "description": "Immutable after any entry, including voided entries, exists."
          },
          "icon_key": {
            "type": "string",
            "enum": [
              "dumbbell",
              "book",
              "leaf",
              "code",
              "droplet",
              "check"
            ]
          },
          "quick_amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9999
          },
          "archived": {
            "type": "boolean"
          },
          "created_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          },
          "updated_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          }
        },
        "required": [
          "id",
          "name",
          "unit",
          "icon_key",
          "quick_amount",
          "archived",
          "created_at_utc_ms",
          "updated_at_utc_ms"
        ]
      },
      "Entry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "project_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999,
            "description": "Positive integer literal on the wire. Reject 1.0, 1e0, booleans and numeric strings in the typed decoder; JSON Schema alone cannot distinguish all lexical encodings."
          },
          "occurred_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          },
          "utc_offset_minutes": {
            "type": "integer",
            "minimum": -840,
            "maximum": 840
          },
          "local_date": {
            "type": "string",
            "format": "date",
            "description": "Date at occurrence, equal to UTC timestamp + captured offset. Never regroup old entries in a new timezone."
          },
          "voided_at_utc_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4102444799999,
                "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "project_id",
          "amount",
          "occurred_at_utc_ms",
          "utc_offset_minutes",
          "local_date",
          "voided_at_utc_ms"
        ]
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "last_seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "exported_at_utc_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444799999,
            "description": "Unix epoch milliseconds in UTC; supplied by the device for domain timestamps."
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          }
        },
        "required": [
          "schema_version",
          "installation_id",
          "last_seq",
          "exported_at_utc_ms",
          "projects",
          "entries"
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
