# Development defaults, not production secrets. The Rust service must load dotenv explicitly
# or receive these variables from the shell / compose environment.
KODO_BIND=127.0.0.1:8080
KODO_DATABASE_URL=sqlite://./var/kodo/kodo.sqlite
RUST_LOG=info
KODO_REGISTER_PER_IP_PER_HOUR=10
KODO_OPERATIONS_PER_INSTALLATION_PER_MINUTE=120
KODO_OPERATION_BURST=60
KODO_SNAPSHOTS_PER_INSTALLATION_PER_MINUTE=6
# Credential secrets are generated by the phone, never configured as a shared app secret.
